---
import Base from '../layouts/Base.astro';
---
<Base title="Message envoyé" description="Merci, votre message a bien été envoyé à l'équipe Nefsy." noindex>
  <section class="section"><div class="narrow center">
    <p class="eyebrow">Merci</p>
    <h1 style="font-size:clamp(2rem,5vw,3rem)">Votre message est bien envoyé</h1>
    <p class="lead">Nous vous répondons dès que possible.</p>
    <p><a class="btn btn--dark" href="/">Retour à l'accueil</a></p>
  </div></section>
</Base>
