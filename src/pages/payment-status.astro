---
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
---
<Base title="Statut du paiement" description="Retournez dans l'application Nefsy pour consulter le statut de votre paiement." noindex>
  <section class="section"><div class="narrow center">
    <p class="eyebrow">Paiement</p>
    <h1 style="font-size:clamp(2rem,5vw,3rem)">Retournez dans l'application</h1>
    <p class="lead">Le statut de votre réservation est visible dans l'application Nefsy.</p>
    <StoreButtons />
  </div></section>
</Base>
