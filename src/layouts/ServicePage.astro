---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { CONTENT } from '../data/services';
import { SERVICES, SITE } from '../data/site';
import type { ServiceKey } from '../data/site';

interface Props { k: ServiceKey }
const c = CONTENT[Astro.props.k];
const meta = SERVICES.find((s) => s.key === c.key)!;
const posts = (await getCollection('blog', (p) => !p.data.draft && c.related.includes(p.id)));
const service = {
  '@type': 'Service',
  '@id': `${SITE.url}${c.path}#service`,
  name: meta.title,
  serviceType: c.schemaType,
  description: c.seoDescription,
  url: `${SITE.url}${c.path}`,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: [{ '@type': 'City', name: 'La Mecque' }, { '@type': 'City', name: 'Médine' }],
  availableChannel: { '@type': 'ServiceChannel', serviceUrl: SITE.appStore },
};
---
<Base title={c.seoTitle} description={c.seoDescription} image={c.hero} schema={[service]}>
  <section class="page-hero">
    <div class="hero__bg"><Image src={c.hero} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" /></div>
    <div class="wrap hero__in">
      <Breadcrumbs items={[{ name: 'Prestations', href: '/prestations' }, { name: meta.nav }]} />
      <p class="eyebrow">{c.kicker}</p>
      <h1>{c.h1} <em>{c.h1em}</em></h1>
      <p class="lead">{c.intro}</p>
      <StoreButtons whatsapp waText={c.waText} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">En pratique</p>
        <h2>{c.whyTitle}</h2>
        <ul class="ticks">{c.why.map((w) => <li>{w}</li>)}</ul>
      </div>
      <div class="split__img reveal"><Image src={c.splitImg} alt={c.splitAlt} widths={[480, 800]} sizes="(min-width:900px) 560px, 100vw" /></div>
    </div>
  </section>

  {c.places && (
    <section class="section section--sand pattern">
      <div class="wrap">
        <div class="center"><p class="eyebrow">Parcours</p><h2>{c.placesTitle}</h2></div>
        <div class="grid grid--3" style="margin-top:2.5rem">
          {c.places.map((p) => (
            <article class="card reveal"><div class="card__body">
              {p.ar && <span lang="ar" dir="rtl" style="font-family:var(--font-arabic);font-size:1.7rem;color:var(--gold-deep);line-height:1.3">{p.ar}</span>}
              <h3>{p.name}</h3><p>{p.text}</p>
            </div></article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--ink">
    <div class="wrap">
      <div class="center"><p class="eyebrow">Réservation</p><h2>Comment réserver</h2><p class="lead">Tout se passe dans l'application Nefsy.</p></div>
      <ol class="steps" style="margin-top:2.5rem;max-width:820px;margin-inline:auto">
        {c.steps.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="narrow">
      {c.notes.map((n) => <div class="note reveal"><strong>{n.title}</strong><p>{n.body}</p></div>)}
      {posts.length > 0 && (
        <div style="margin-top:2.5rem">
          <h3>À lire pour aller plus loin</h3>
          <ul>{posts.map((p) => <li><a href={`/blog/${p.id}`}>{p.data.title}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <section class="section section--sand">
    <div class="narrow">
      <div class="center"><p class="eyebrow">Questions</p><h2>Questions fréquentes</h2></div>
      <div style="margin-top:2rem"><Faq items={c.faq} /></div>
    </div>
  </section>

  <section class="section"><div class="wrap"><CtaBand title={meta.cta} waText={c.waText} image={c.splitImg} /></div></section>
</Base>
