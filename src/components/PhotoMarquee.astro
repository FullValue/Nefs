---
// Carrousel d'origine : 5 photos en défilement infini, fondu sur les bords.
import { Image } from 'astro:assets';
import p1 from '../assets/galerie-1.jpeg';
import p2 from '../assets/galerie-2.jpeg';
import p3 from '../assets/guides-nefsy.jpeg';
import p4 from '../assets/galerie-4.jpeg';
import p5 from '../assets/galerie-5.jpeg';
const photos = [p1, p2, p3, p4, p5];
const loop = [...photos, ...photos];
---
<section class="mq" aria-label="Galerie photos">
  <div class="mq__track">
    {loop.map((src, i) => (
      <div class="mq__item" aria-hidden={i >= photos.length ? 'true' : undefined}>
        <Image src={src} alt="" widths={[300, 600]} sizes="(min-width:1024px) 340px, 280px" loading="lazy" draggable="false" />
      </div>
    ))}
  </div>
</section>

<style>
  .mq { position: relative; overflow: hidden; padding-block: clamp(4rem, 7vw, 6rem); background: #fff; }
  .mq::before, .mq::after { content: ''; position: absolute; top: 0; bottom: 0; width: clamp(80px, 16vw, 256px); z-index: 2; pointer-events: none; }
  .mq::before { left: 0; background: linear-gradient(to right, #fff, rgba(255,255,255,.85), transparent); }
  .mq::after { right: 0; background: linear-gradient(to left, #fff, rgba(255,255,255,.85), transparent); }
  .mq__track { display: flex; gap: 1.5rem; width: max-content; animation: mq 60s linear infinite; }
  .mq__item { flex: none; width: 280px; aspect-ratio: 3/4; border-radius: 1.5rem; overflow: hidden; box-shadow: 0 10px 25px -8px rgba(0,0,0,.2); background: #eee; }
  .mq__item :global(img) { width: 100%; height: 100%; object-fit: cover; user-select: none; }
  @media (min-width: 1024px) { .mq__item { width: 340px; } }
  @keyframes mq { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .mq__track { animation: none; overflow-x: auto; } .mq { overflow-x: auto; } }
</style>
