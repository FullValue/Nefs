---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { SITE, SERVICES, LEGAL, whatsappLink } from '../data/site';
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <div class="footer__logo"><Image src={logo} alt="Nefsy" height={44} width={132} loading="lazy" /></div>
        <p>Guides religieux pour votre Omra, votre Omra Badal et vos visites à La Mecque et à Médine. Un accompagnement fondé sur l'amānah : la confiance et l'honnêteté.</p>
        <div class="social">
          <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M7.800 2h8.400A5.800 5.800 0 0 1 22 7.800v8.400a5.800 5.800 0 0 1-5.800 5.800H7.800A5.800 5.800 0 0 1 2 16.200V7.800A5.800 5.800 0 0 1 7.800 2zm-.2 2A3.600 3.600 0 0 0 4 7.600v8.800A3.600 3.600 0 0 0 7.600 20h8.800a3.600 3.600 0 0 0 3.600-3.600V7.600A3.600 3.600 0 0 0 16.400 4H7.600zM17.300 5.500a1.200 1.200 0 1 1 0 2.400 1.200 1.200 0 0 1 0-2.400zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg></a>
          <a href={SITE.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M19.590 6.690a4.830 4.830 0 0 1-3.770-4.250V2h-3.450v13.670a2.890 2.890 0 0 1-5.200 1.740 2.890 2.890 0 0 1 2.310-4.640 2.930 2.930 0 0 1 .88.130V9.400a6.840 6.840 0 0 0-1-.05A6.330 6.330 0 0 0 5 15.680a6.340 6.340 0 0 0 6.260 6.320 6.330 6.330 0 0 0 6.310-6.320V10a8.100 8.100 0 0 0 4.790 1.540V8.220a4.420 4.420 0 0 1-2.770-1.530z"/></svg></a>
        </div>
      </div>
      <div>
        <h4>Prestations</h4>
        <ul>{SERVICES.map((s) => <li><a href={s.path}>{s.nav}</a></li>)}</ul>
      </div>
      <div>
        <h4>Nefsy</h4>
        <ul>
          <li><a href="/a-propos">À propos</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href={whatsappLink()} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
      </div>
      <div>
        <h4>Informations légales</h4>
        <ul>{LEGAL.map((l) => <li><a href={l.href}>{l.title}</a></li>)}</ul>
      </div>
    </div>
    <p class="footer__basmala" lang="ar">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
    <p class="footer__copy">© {new Date().getFullYear()} Nefsy · édité par {SITE.legalName} · Designed by Ulycom</p>
  </div>
</footer>
<a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener noreferrer" aria-label="Nous écrire sur WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.500 3.500A11.800 11.800 0 0 0 12 0C5.400 0 .1 5.300.1 11.900c0 2.100.5 4.100 1.600 5.900L0 24l6.400-1.700a11.900 11.900 0 0 0 5.600 1.400c6.600 0 11.900-5.300 11.900-11.900 0-3.200-1.200-6.200-3.400-8.300zM12 21.700c-1.800 0-3.500-.5-5-1.400l-.4-.2-3.800 1 1-3.700-.2-.4a9.800 9.800 0 0 1-1.500-5.200C2.100 6.500 6.500 2.100 12 2.100c2.600 0 5.100 1 6.900 2.900a9.700 9.700 0 0 1 2.900 6.900c0 5.400-4.400 9.800-9.800 9.800zm5.400-7.300c-.3-.1-1.800-.9-2-1-.3-.1-.5-.1-.7.100-.2.300-.8 1-.9 1.200-.2.200-.3.200-.6.100-.3-.1-1.200-.4-2.300-1.400-.9-.8-1.400-1.700-1.600-2-.2-.3 0-.5.100-.6l.4-.5c.1-.2.200-.3.300-.5.100-.2 0-.4 0-.5-.1-.1-.7-1.600-.9-2.200-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.100-.8.400-.3.300-1 1-1 2.500s1.100 2.900 1.200 3.100c.1.200 2.100 3.200 5.100 4.500.7.300 1.300.5 1.700.6.700.2 1.400.2 1.900.1.600-.1 1.800-.7 2-1.400.3-.7.300-1.300.2-1.400-.1-.1-.3-.2-.6-.3z"/></svg>
</a>
