---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import StoreButtons from './StoreButtons.astro';
import { SITE, SERVICES, LEGAL, whatsappLink } from '../data/site';
const waIcon = 'M20.5 3.5A11.8 11.8 0 0 0 12 0C5.4 0 .1 5.3.1 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.4-1.7a11.9 11.9 0 0 0 5.6 1.4c6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.4-8.3zM12 21.7c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 0 1-1.5-5.2C2.1 6.5 6.5 2.1 12 2.1c2.6 0 5.1 1 6.9 2.9a9.7 9.7 0 0 1 2.9 6.9c0 5.4-4.4 9.8-9.8 9.8zm5.4-7.3c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3z';
---
<footer class="footer">
  <div class="footer__glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="footer__top">
      <div>
        <p class="eyebrow">Nefsy</p>
        <p class="footer__claim">Votre Omra, accompagnée par des guides de confiance.</p>
      </div>
      <StoreButtons />
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="Nefsy, accueil"><Image src={logo} alt="Nefsy" height={56} width={168} loading="lazy" /></a>
        <p>Guides religieux pour votre Omra, votre Omra Badal et vos visites à La Mecque et à Médine. Un accompagnement fondé sur l'amānah : la confiance et l'honnêteté.</p>
        <div class="social">
          <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6zM17.3 5.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg></a>
          <a href={SITE.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 15.68a6.34 6.34 0 0 0 6.26 6.32 6.33 6.33 0 0 0 6.31-6.32V10a8.1 8.1 0 0 0 4.79 1.54V8.22a4.42 4.42 0 0 1-2.77-1.53z"/></svg></a>
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24"><path d={waIcon}/></svg></a>
        </div>
      </div>
      <div>
        <h4>Prestations</h4>
        <ul>{SERVICES.map((s) => <li><a href={s.path}>{s.nav}</a></li>)}</ul>
      </div>
      <div>
        <h4>Nefsy</h4>
        <ul>
          <li><a href="/a-propos">À propos</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Nous joindre</h4>
        <ul class="footer__contact">
          <li><a href={whatsappLink()} target="_blank" rel="noopener noreferrer"><span>WhatsApp</span>Écrire un message</a></li>
          <li><a href={`mailto:${SITE.email}`}><span>E-mail</span>{SITE.email}</a></li>
          <li><a href={`mailto:${SITE.supportEmail}`}><span>Support app</span>{SITE.supportEmail}</a></li>
        </ul>
      </div>
    </div>

    <p class="footer__basmala" lang="ar">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>

    <div class="footer__bottom">
      <p>© {new Date().getFullYear()} Nefsy · édité par {SITE.legalName} · Designed by Ulycom</p>
      <ul>{LEGAL.map((l) => <li><a href={l.href}>{l.title}</a></li>)}</ul>
    </div>
  </div>
</footer>

<a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener noreferrer" aria-label="Nous écrire sur WhatsApp">
  <span class="wa-float__ring" aria-hidden="true"></span>
  <span class="wa-float__ring wa-float__ring--2" aria-hidden="true"></span>
  <span class="wa-float__label">Une question ? <b>Écrivez-nous</b></span>
  <span class="wa-float__btn">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={waIcon}/></svg>
    <span class="wa-float__dot" aria-hidden="true"></span>
  </span>
</a>
