---
// Hero d'origine de la landing page (badge, titre, boutons stores, 3 téléphones, 3 cartes flottantes, étoiles dorées).
import { Image } from 'astro:assets';
import screen1 from '../assets/app-1.jpeg';
import screen2 from '../assets/app-2.jpeg';
import screen3 from '../assets/app-3.jpeg';
import backdrop from '../assets/visite-medine.jpg';
import { SITE } from '../data/site';

const sparkles = [
  { top: '15%', left: '15%', size: 24, delay: 0 },
  { top: '25%', left: '85%', size: 32, delay: 1.2 },
  { top: '55%', left: '10%', size: 20, delay: 0.5 },
  { top: '75%', left: '85%', size: 28, delay: 2 },
  { top: '40%', left: '80%', size: 16, delay: 0.8 },
];
---
<section class="oh">
  <div class="oh__photo" aria-hidden="true"><Image src={backdrop} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" /></div>
  <div class="oh__glow" aria-hidden="true"></div>
  <div class="oh__pattern pattern" aria-hidden="true"></div>
  <svg class="rosace" viewBox="0 0 400 400" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1">
      <circle cx="200" cy="200" r="196" />
      <circle cx="200" cy="200" r="150" stroke-dasharray="2 6" />
      {[0, 22.5, 45, 67.5].map((a) => <rect x="80" y="80" width="240" height="240" transform={`rotate(${a} 200 200)`} />)}
      {[0, 45].map((a) => <rect x="128" y="128" width="144" height="144" transform={`rotate(${a} 200 200)`} />)}
      <circle cx="200" cy="200" r="60" />
    </g>
  </svg>
  <div class="oh__sparkles" aria-hidden="true">
    {sparkles.map((p) => (
      <span class="spark" style={`top:${p.top};left:${p.left};width:${p.size}px;height:${p.size}px;animation-delay:${p.delay}s`}>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0L13.5 10.5L24 12L13.5 13.5L12 24L10.5 13.5L0 12L10.5 10.5L12 0Z" /></svg>
      </span>
    ))}
  </div>
  <svg class="fili fili--l" viewBox="0 0 200 200" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.5"><rect x="40" y="40" width="120" height="120" transform="rotate(45 100 100)" /><rect x="40" y="40" width="120" height="120" /><circle cx="100" cy="100" r="50" /><circle cx="100" cy="100" r="35" /></g></svg>
  <svg class="fili fili--r" viewBox="0 0 200 200" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.5"><rect x="40" y="40" width="120" height="120" transform="rotate(45 100 100)" /><rect x="40" y="40" width="120" height="120" /><circle cx="100" cy="100" r="50" /><circle cx="100" cy="100" r="35" /></g></svg>
  <div class="ring ring--1" aria-hidden="true"></div>
  <div class="ring ring--2" aria-hidden="true"></div>

  <div class="oh__in">
    <p class="oh__badge">★ L'application n°1 pour votre Omra</p>
    <h1>Votre guide de confiance pour la <em>Omra</em></h1>
    <p class="oh__lead">Réservez des guides religieux certifiés pour faciliter votre Omra ou vos visites à Médine. Une plateforme basée sur la confiance, l'éthique et la bienveillance (Amānah).</p>
    <div class="oh__stores">
      <a class="store" href={SITE.appStore} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 384 512" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
        <span><small>Télécharger sur l'</small><b>App Store</b></span>
      </a>
      <a class="store" href={SITE.playStore} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/></svg>
        <span><small>Disponible sur</small><b>Google Play</b></span>
      </a>
    </div>
  </div>

  <div class="phones">
    <div class="phone phone--c"><Image src={screen1} alt="Écran de l'application Nefsy" widths={[340, 680]} sizes="340px" loading="eager" /></div>
    <div class="phone phone--l"><Image src={screen2} alt="Écran de l'application Nefsy" widths={[260, 520]} sizes="260px" loading="eager" /></div>
    <div class="phone phone--r"><Image src={screen3} alt="Écran de l'application Nefsy" widths={[260, 520]} sizes="260px" loading="eager" /></div>
    <div class="fcard fcard--a"><span class="fcard__i fcard__i--g">✓</span><div><small>Paiement</small><b>100% Sécurisé</b></div></div>
    <div class="fcard fcard--b"><span class="fcard__i fcard__i--o">★</span><div><small>Guides</small><b>Vérifiés &amp; Certifiés</b></div></div>
    <div class="fcard fcard--c"><span class="fcard__i fcard__i--b">▶</span><div><small>Omra Badal</small><b>Preuves Vidéo</b></div></div>
  </div>
</section>

<style>
  .oh { position: relative; isolation: isolate; overflow: hidden; text-align: center; background: linear-gradient(180deg, #fbf6ea 0%, #fffdf8 55%, #fff 100%); padding-top: clamp(4rem, 8vw, 7rem); }
  /* Fond : photo de Médine très estompée, halo doré, motif et rosace qui tourne lentement */
  .oh__photo { position: absolute; inset: 0 0 35% 0; z-index: -3; opacity: .2; filter: sepia(.35) saturate(.8); -webkit-mask-image: linear-gradient(180deg, #000 20%, transparent); mask-image: linear-gradient(180deg, #000 20%, transparent); }
  .oh__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .oh__glow { position: absolute; z-index: -2; inset: 0; background: radial-gradient(60% 45% at 50% 30%, rgba(255,253,248,.92), rgba(255,253,248,.55) 60%, transparent), radial-gradient(40% 35% at 15% 85%, rgba(208,166,74,.16), transparent), radial-gradient(40% 35% at 85% 70%, rgba(208,166,74,.14), transparent); }
  .oh__pattern { position: absolute; inset: 0; z-index: -2; opacity: .55; -webkit-mask-image: radial-gradient(70% 60% at 50% 40%, transparent 30%, #000); mask-image: radial-gradient(70% 60% at 50% 40%, transparent 30%, #000); }
  .rosace { position: absolute; z-index: -1; left: 50%; bottom: -260px; width: min(980px, 190vw); height: auto; color: var(--gold); opacity: .16; transform: translateX(-50%); animation: rosace 140s linear infinite; pointer-events: none; }
  @keyframes rosace { to { transform: translateX(-50%) rotate(360deg); } }
  .oh__in { position: relative; z-index: 2; width: min(100% - 2.5rem, 880px); margin-inline: auto; }
  .oh__badge { display: inline-block; background: rgba(179, 134, 42, .1); color: var(--gold-deep); padding: .5rem 1.1rem; border-radius: 999px; font-weight: 600; font-size: .9rem; margin-bottom: 1.4rem; }
  .oh h1 { font-size: clamp(2.3rem, 6vw, 4.6rem); line-height: 1.08; margin-bottom: 1.2rem; }
  .oh h1 em { font-style: italic; color: var(--gold); }
  .oh__lead { color: #555; font-size: 1.15rem; max-width: 42rem; margin: 0 auto 2.2rem; }
  .oh__stores { display: flex; flex-wrap: wrap; gap: .9rem; justify-content: center; margin-bottom: 2rem; }
  .fili { position: absolute; color: var(--gold); opacity: .15; pointer-events: none; }
  .fili--l { top: 40px; left: -80px; width: 380px; }
  .fili--r { top: 160px; right: -80px; width: 480px; }
  .ring { position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%); border: 1px solid rgba(179, 134, 42, .12); border-radius: 50%; pointer-events: none; }
  .ring--1 { width: min(800px, 160vw); aspect-ratio: 1; }
  .ring--2 { width: min(1200px, 240vw); aspect-ratio: 1; border-color: rgba(179, 134, 42, .06); }
  .oh__sparkles { position: absolute; inset: 0; pointer-events: none; }
  .spark { position: absolute; color: var(--gold); animation: twinkle 3.5s ease-in-out infinite; }
  @keyframes twinkle { 0%, 100% { opacity: .3; transform: scale(.8) rotate(0); } 50% { opacity: .9; transform: scale(1.3) rotate(45deg); } }

  .phones { position: relative; width: min(100%, 1000px); height: 420px; margin: 1rem auto 0; }
  .phone { position: absolute; bottom: 0; background: #fff; border: 10px solid #000; border-bottom: 0; border-radius: 2rem 2rem 0 0; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,.35); }
  .phone :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .phone--c { left: 50%; transform: translateX(-50%); width: 220px; height: 400px; z-index: 3; }
  .phone--l { left: -2%; bottom: 20px; width: 150px; height: 340px; z-index: 2; opacity: .92; }
  .phone--r { right: -2%; bottom: 40px; width: 150px; height: 340px; z-index: 2; opacity: .92; }
  .fcard { position: absolute; z-index: 4; display: flex; align-items: center; gap: .6rem; background: rgba(255,255,255,.95); border: 1px solid rgba(255,255,255,.6); border-radius: 14px; padding: .5rem .7rem; box-shadow: 0 8px 30px rgba(0,0,0,.12); text-align: left; }
  .fcard small { display: block; font-size: .55rem; text-transform: uppercase; letter-spacing: .08em; color: #777; line-height: 1.2; }
  .fcard b { font-size: .75rem; color: var(--ink); line-height: 1.2; }
  .fcard__i { width: 2rem; height: 2rem; border-radius: 50%; display: grid; place-items: center; flex: none; font-size: .9rem; }
  .fcard__i--g { background: #ecf8f0; color: #16a34a; border: 1px solid #bbf7d0; }
  .fcard__i--o { background: rgba(179,134,42,.12); color: var(--gold); border: 1px solid rgba(179,134,42,.3); }
  .fcard__i--b { background: #eff6ff; color: #3b82f6; border: 1px solid #bfdbfe; }
  .fcard--a { top: 12%; left: 8px; }
  .fcard--b { top: 30%; right: 8px; }
  .fcard--c { bottom: 28%; left: 8px; }
  @media (min-width: 640px) {
    .phones { height: 520px; }
    .phone { border-width: 12px; border-radius: 2.5rem 2.5rem 0 0; }
    .phone--c { width: 300px; height: 520px; }
    .phone--l, .phone--r { width: 220px; height: 400px; }
    .phone--l { left: 5%; bottom: -50px; }
    .phone--r { right: 5%; bottom: -30px; }
    .fcard { padding: .9rem 1.1rem; gap: 1rem; border-radius: 18px; }
    .fcard small { font-size: .7rem; } .fcard b { font-size: 1rem; }
    .fcard__i { width: 3rem; height: 3rem; font-size: 1.2rem; }
    .fcard--a { top: 15%; left: 2%; } .fcard--b { top: 5%; right: 2%; } .fcard--c { bottom: 20%; left: -2%; }
  }
  @media (min-width: 1024px) {
    .phones { height: 580px; }
    .phone--c { width: 340px; height: 580px; }
    .phone--l, .phone--r { width: 260px; height: 480px; }
    .phone--l { left: 10%; } .phone--r { right: 10%; }
    .fcard--a { left: 5%; } .fcard--b { right: 5%; } .fcard--c { left: 2%; }
  }
  @media (prefers-reduced-motion: reduce) { .spark, .rosace { animation: none; } .spark { opacity: .5; } }
</style>
