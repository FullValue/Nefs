{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/deleteaccount", "destination": "/delete-account", "permanent": true },
    { "source": "/suppressioncompte", "destination": "/delete-account", "permanent": true },
    { "source": "/suppression-de-compte", "destination": "/delete-account", "permanent": true },
    { "source": "/mentions-legales", "destination": "/mentionslegales", "permanent": true },
    { "source": "/chartes-ethiques", "destination": "/chartesethiques", "permanent": true },
    { "source": "/visites-guidees", "destination": "/prestations", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
